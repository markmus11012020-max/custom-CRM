*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Виртуальные окружения ------------------------------------------------
.venv/
venv/
env/

# --- IDE и ОС -------------------------------------------------------------
.idea/
.vscode/
Thumbs.db
desktop.ini

# --- Сборки ---------------------------------------------------------------
build/
dist/
